# NVIDIA SHIELD Remote (Bluetooth) -- make OK and Menu usable on the desktop.
#   OK    usage 0x0c0041 "Menu Pick" -> KEY_SELECT (353) -> keysym XF86Select
#   Menu  usage 0x0c0040 "Menu"      -> KEY_MENU   (139) -> keysym XF86MenuKB

# Match: bus 0005 = Bluetooth, vendor 0955 = NVIDIA, product 7217 = SHIELD Remote
evdev:input:b0005v0955p7217*
 KEYBOARD_KEY_c0041=enter
 KEYBOARD_KEY_c0040=compose
 KEYBOARD_KEY_c0030=prog1
 KEYBOARD_KEY_10081=prog1
